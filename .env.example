# Copie este arquivo para .env e ajuste. O .env NUNCA vai para o GitHub.
# Sem .env, a API usa SQLite (arquivo estoque.db), ótimo para testar rápido.

# PostgreSQL (troque SENHA pela senha do seu Postgres):
# DATABASE_URL=postgresql+psycopg2://postgres:SENHA@localhost:5432/estoque

# Chave secreta que assina os tokens de login (JWT). Gere a sua com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# e cole o resultado aqui. Sem ela, a API gera uma chave temporária
# e todos precisam entrar de novo sempre que a API reinicia.
SECRET_KEY=

# Quanto tempo (em minutos) o login vale antes de expirar.
TOKEN_EXPIRA_MINUTOS=60

# Endereços que podem acessar a API pelo navegador, separados por vírgula.
# "*" libera qualquer um (bom para desenvolvimento).
# Exemplo: CORS_ORIGINS=http://127.0.0.1:5500,https://thiagomartinsmdev.github.io
CORS_ORIGINS=*
